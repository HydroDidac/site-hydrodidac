---
import Layout from "../components/Layout.astro";
---
<Layout
  title="Page introuvable — HydroDidac"
  description="Cette page n'existe pas ou a été déplacée."
>
  <main id="contenu" style="max-width: 720px; margin: 0 auto; padding: 4rem 1rem; text-align: center;">
    <p style="font-family: var(--font-valeurs); font-size: 3rem; color: var(--color-bleu-hydraulique); margin: 0;">404</p>
    <h1>Cette page n'existe pas</h1>
    <p>
      Elle a peut-être été déplacée, ou l'adresse contient une erreur.
      Pas de fuite dans le circuit pour autant :
    </p>
    <p style="margin-top: 2rem;">
      <a href="/fiches" class="niveau-tab actif" style="text-decoration: none; padding: 0.6em 1.4em;">
        Voir toutes les fiches
      </a>
    </p>
    <p><a href="/">← Retour à l'accueil</a></p>
  </main>
</Layout>
