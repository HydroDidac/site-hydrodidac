  }
  /* Impression : on ne garde que les calculateurs et leurs résultats, pour une
     note de calcul lisible à glisser dans un dossier machine. Les couleurs de
     fond disparaissent (illisibles et coûteuses en encre), les cartes ne se
     coupent pas en travers d'une page. */
  @media print {
    .calc-page {
      max-width: 100%;
      padding: 0;
    }
    .calc-layout {
      display: block;
    }
    .calc-sommaire,
    .calc-retour,
    .calc-intro {
      display: none !important;
    }
    .calc-grille {
      display: block;
      margin: 0;
    }
    .calc-carte {
      break-inside: avoid;
      border: 1px solid #000;
