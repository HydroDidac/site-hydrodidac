    .calc-filtres {
      display: none;
    }
    .calc-carte input,
    .calc-carte select {
      background: #fff;
      border: 1px solid #666;
    }
    .calc-resultat {
      background: #fff !important;
      color: #000 !important;
      border: 1px solid #000;
    }
    .resultat-label,
    .resultat-valeur {
      color: #000 !important;
      opacity: 1;
    }
    .calc-formule {
      background: #fff;
      border-left: 3px solid #000;
    }
  }
  /* Convertisseur d'unités : une ligne = deux champs équivalents */
  .calc-conversions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0.4rem 1.4rem;
  }
  .calc-conv-ligne {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 0.5rem;
  }
  .calc-conv-signe {
    font-family: var(--font-valeurs);
    font-weight: 700;
    color: #51606b;
    padding-bottom: 0.55em;
  }
  .calc-huile-info .calc-huile-badge {
    display: inline-block;
    font-family: var(--font-valeurs);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-bleu-hydraulique);
    background: var(--color-formule-fond);
    border-radius: 3px;
    padding: 0.1em 0.5em;
    margin-right: 0.4em;
  }
</style>

<script>
  import { infosFamille } from "../data/huiles-hydrauliques.js";
  import { catalogue, libelleHuile } from "../data/huiles-standard.js";
  import { grandeursLiees, exemples } from "../data/calculateurs-nav.js";

  const fmtFr = (valeur: number, decimales = 1) =>
    new Intl.NumberFormat("fr-FR", {
      minimumFractionDigits: 0,
      maximumFractionDigits: decimales,
    }).format(valeur);

  const lire = (id: string): number => {
    const champ = document.getElementById(id) as HTMLInputElement | null;
    const v = champ ? parseFloat(champ.value) : NaN;
    return Number.isFinite(v) && v >= 0 ? v : NaN;
  };

  /** Comme `lire`, mais accepte les valeurs négatives (températures). */
  const lireLibre = (id: string): number => {
    const champ = document.getElementById(id) as HTMLInputElement | null;
    const v = champ ? parseFloat(champ.value) : NaN;
    return Number.isFinite(v) ? v : NaN;
  };

  const afficher = (id: string, texte: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = texte;
  };

  /** Comme `afficher`, mais insère du HTML (contenu interne, non issu d'une saisie utilisateur). */
  const afficherHTML = (id: string, html: string) => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = html;
  };

  const listeHTML = (items: string[]) => items.map((item) => `<li>${item}</li>`).join("");

  /** Surface d'un disque en cm² à partir d'un diamètre en mm. */
  const surfaceCm2 = (diametreMm: number) => (Math.PI * (diametreMm / 10) ** 2) / 4;

  /** Section d'un tube en m² à partir d'un diamètre en mm. */
  const sectionM2 = (diametreMm: number) => (Math.PI * (diametreMm / 1000) ** 2) / 4;

  /**
   * Surface d'échange d'un réservoir (m²) à partir de sa contenance en litres,
   * en l'assimilant à un cube. Estimation partagée par les deux calculateurs
   * thermiques de la page, pour qu'ils ne donnent pas deux réponses
   * différentes sur le même réservoir.
   */
  const surfaceReservoir = (volumeLitres: number) => 6 * (volumeLitres / 1000) ** (2 / 3);

  /**
   * Viscosité cinématique (cSt) à la température voulue, par l'équation de
   * Walther / ASTM D341 : W(ν) = log10(log10(ν + 0,7)) est linéaire en
   * log10(T en kelvins). Avec les deux points de la fiche technique (40 °C et
   * 100 °C), c'est la pente réelle de l'huile qui est utilisée — donc son VI
   * réel, et non une valeur moyenne. Renvoie NaN si les données sont
   * inutilisables (viscosités incohérentes, température trop basse).
   */
  const viscositeA = (n40: number, n100: number, tC: number): number => {
    if (!(n40 > 2 && n100 > 0.5 && n40 > n100 && Number.isFinite(tC) && tC > -30)) return NaN;
    const t40 = Math.log10(40 + 273.15), t100 = Math.log10(100 + 273.15);
    const w = (nu: number) => Math.log10(Math.log10(nu + 0.7));
    const pente = (w(n40) - w(n100)) / (t100 - t40);
    return 10 ** 10 ** (w(n40) - pente * (Math.log10(tC + 273.15) - t40)) - 0.7;
  };

  /**
   * Masse volumique (kg/m³) à la température voulue, par famille d'huile.
   * Valeurs à 15 °C relevées sur les fiches techniques des fabricants ; les
   * esters biodégradables sont sensiblement plus denses que les minérales.
   * La dilatation thermique retire environ 0,65 kg/m³ par degré.
   */
  const massesVolumiques: Record<string, number> = {
    HM: 875,
    HV: 870,
    HEES: 920,
    "Turbine/UTTO": 870,
  };
  const masseVolumiqueA = (famille: string, tC: number) =>
    (massesVolumiques[famille] ?? 870) - 0.65 * (tC - 15);

  /**
   * Verdict sur le régime d'écoulement dans un orifice calibré. Le coefficient
   * de débit Cd n'est constant qu'en régime turbulent : en dessous, le débit
   * réel devient dépendant de la viscosité et la formule perd sa validité.
   */
  const verdictOrifice = (re: number) => {
    if (re >= 1000)
      return "✅ Régime turbulent dans l'orifice : le coefficient de débit est stable, le calcul est fiable.";
    if (re >= 100)
      return "🟠 Régime transitoire : le coefficient de débit réel est plus faible qu'annoncé, le débit obtenu sera inférieur au calcul. Prévoyez un réglage au banc.";
    return "⚠️ Régime visqueux : à cette viscosité, le débit dépend surtout de l'huile et non plus de la seule section. La formule ne s'applique plus — refaites le calcul à la température réelle de service.";
  };

  const calculer = () => {
    // 1. Puissance hydraulique : P = Q × p / 600
    const puQ = lire("pu-q"), puP = lire("pu-p");
    afficher("pu-res", puQ >= 0 && puP >= 0 ? `${fmtFr((puQ * puP) / 600, 2)} kW` : "—");

    // 2. Débit de pompe : Q = Cyl × N × ηv / 1000
    const deCyl = lire("de-cyl"), deN = lire("de-n"), deRv = lire("de-rv");
    afficher(
      "de-res",
      deCyl >= 0 && deN >= 0 && deRv >= 0
        ? `${fmtFr((deCyl * deN * (deRv / 100)) / 1000, 1)} L/min`
        : "—"
    );

    // 3. Couple : C = Cyl × Δp / (20π)
    const coCyl = lire("co-cyl"), coDp = lire("co-dp");
    afficher(
      "co-res",
      coCyl >= 0 && coDp >= 0 ? `${fmtFr((coCyl * coDp) / (20 * Math.PI), 1)} Nm` : "—"
    );

    // 4. Force de vérin : F(N) = p × S(cm²) × 10 — affichée en daN / kN
    const foD = lire("fo-d"), foT = lire("fo-t"), foP = lire("fo-p");
    if (foD >= 0 && foT >= 0 && foP >= 0 && foT < foD) {
      const sFond = surfaceCm2(foD);
      const sAnnulaire = sFond - surfaceCm2(foT);
      const fExt = foP * sFond * 10;
      const fRet = foP * sAnnulaire * 10;
      const enKn = (f: number) =>
        f >= 10000 ? `${fmtFr(f / 1000, 1)} kN` : `${fmtFr(f / 10, 0)} daN`;
      afficher("fo-res-ext", enKn(fExt));
      afficher("fo-res-ret", enKn(fRet));
    } else {
      afficher("fo-res-ext", "—");
      afficher("fo-res-ret", "—");
    }

    // 5. Vitesse de vérin : v = Q / (6 × S)
    const vvQ = lire("vv-q"), vvD = lire("vv-d"), vvT = lire("vv-t");
    if (vvQ >= 0 && vvD > 0 && vvT >= 0 && vvT < vvD) {
      const sFond = surfaceCm2(vvD);
      const sAnnulaire = sFond - surfaceCm2(vvT);
      afficher("vv-res-ext", `${fmtFr(vvQ / (6 * sFond), 3)} m/s`);
      afficher("vv-res-ret", `${fmtFr(vvQ / (6 * sAnnulaire), 3)} m/s`);
    } else {
      afficher("vv-res-ext", "—");
      afficher("vv-res-ret", "—");
    }

    // 6. Vitesse en conduite : v = Q/60000 ÷ (π(d/1000)²/4)
    const vcQ = lire("vc-q"), vcD = lire("vc-d");
    const vcLigneEl = document.getElementById("vc-ligne") as HTMLSelectElement | null;
    const vcLigne = vcLigneEl ? vcLigneEl.value : "pression";
    const plagesConduite: Record<string, { min: number; max: number; nom: string }> = {
      aspiration: { min: 0.6, max: 1.2, nom: "aspiration" },
      retour: { min: 2, max: 4, nom: "retour" },
      pression: { min: 3, max: 6, nom: "pression" },
    };
    // Surligne la ligne du tableau correspondant au type sélectionné.
    ["aspiration", "retour", "pression"].forEach((l) => {
      document.getElementById(`vc-row-${l}`)?.classList.toggle("ligne-active", l === vcLigne);
    });
    if (vcQ >= 0 && vcD > 0) {
      const vConduite = (vcQ / 60000) / ((Math.PI * (vcD / 1000) ** 2) / 4);
      afficher("vc-res", `${fmtFr(vConduite, 2)} m/s`);
      const p = plagesConduite[vcLigne] ?? plagesConduite.pression;
      const plage = `${fmtFr(p.min, 1)}–${fmtFr(p.max, 1)} m/s`;
      let verdict = "";
      if (vConduite < p.min) {
        verdict = `🟡 Ligne de ${p.nom} : vitesse sous la plage conseillée (${plage}). Conduite surdimensionnée — sans risque, mais plus encombrante et coûteuse que nécessaire.`;
      } else if (vConduite <= p.max) {
        verdict = `✅ Ligne de ${p.nom} : vitesse dans la plage conseillée (${plage}).`;
      } else if (vcLigne === "aspiration") {
        verdict = `⚠️ Ligne d'aspiration : au-dessus de ${fmtFr(p.max, 1)} m/s. Risque de cavitation de la pompe — augmentez le diamètre.`;
      } else {
        verdict = `⚠️ Ligne de ${p.nom} : au-dessus de ${fmtFr(p.max, 1)} m/s. Pertes de charge et échauffement accrus — augmentez le diamètre.`;
      }
      afficher("vc-verdict", verdict);
    } else {
      afficher("vc-res", "—");
      afficher("vc-verdict", "");
    }

    // 7. Reynolds : Re = 1000 × v × d / ν
    const reV = lire("re-v"), reD = lire("re-d"), reNu = lire("re-nu");
    if (reV >= 0 && reD >= 0 && reNu > 0) {
      const re = (1000 * reV * reD) / reNu;
      afficher("re-res", fmtFr(re, 0));
      let verdict = "";
      if (re < 2300) verdict = "✅ Régime laminaire : écoulement régulier, c'est l'objectif en hydraulique.";
      else if (re <= 3000) verdict = "🟠 Régime transitoire : instable, à éviter si possible.";
      else verdict = "⚠️ Régime turbulent : pertes de charge et échauffement accrus.";
      afficher("re-verdict", verdict);
    } else {
      afficher("re-res", "—");
      afficher("re-verdict", "");
    }

    // 8. Viscosité–température (équation de Walther / ASTM D341)
    const viHuileSelect = document.getElementById("vi-huile") as HTMLSelectElement | null;
    const viHuileValide = !!viHuileSelect?.selectedOptions[0] && !viHuileSelect.selectedOptions[0].disabled;
    const nu = viscositeA(lire("vi-n1"), lire("vi-n2"), lireLibre("vi-t"));
    if (viHuileValide && Number.isFinite(nu)) {
      afficher("vi-res", `${fmtFr(nu, nu < 100 ? 1 : 0)} cSt`);
      let verdict = "";
      if (nu < 10) verdict = "⚠️ Viscosité trop faible : film d'huile insuffisant, usure et fuites internes accrues. L'huile est trop chaude ou trop fluide.";
      else if (nu < 16) verdict = "🟠 Limite basse : acceptable ponctuellement, surveillez la température.";
      else if (nu <= 36) verdict = "✅ Plage optimale de fonctionnement pour la plupart des pompes (16 – 36 cSt).";
      else if (nu <= 1000) verdict = "🟠 Au-dessus de la plage optimale : normal en dessous de la température de service. Rendement un peu réduit ; à froid, montez en charge progressivement.";
      else verdict = "⚠️ Trop visqueuse pour pomper : risque de cavitation à l'aspiration. Préchauffez l'huile.";
      afficher("vi-verdict", verdict);
    } else {
      afficher("vi-res", "—");
      afficher("vi-verdict", "");
    }

    // 9. Temps de course : t = V × 60 / Q, avec V = S(cm²) × course(cm) / 1000
    const tvC = lire("tv-c"), tvD = lire("tv-d"), tvT = lire("tv-t"), tvQ = lire("tv-q");
    if (tvC >= 0 && tvD > 0 && tvT >= 0 && tvT < tvD && tvQ > 0) {
      const sFond = surfaceCm2(tvD);
      const sAnnulaire = sFond - surfaceCm2(tvT);
      const vFond = (sFond * (tvC / 10)) / 1000;
      const vAnnulaire = (sAnnulaire * (tvC / 10)) / 1000;
      afficher("tv-res-ext", `${fmtFr((vFond * 60) / tvQ, 1)} s`);
      afficher("tv-res-ret", `${fmtFr((vAnnulaire * 60) / tvQ, 1)} s`);
      afficher("tv-note", `Volume à remplir : ${fmtFr(vFond, 2)} L côté fond · ${fmtFr(vAnnulaire, 2)} L côté annulaire.`);
    } else {
      afficher("tv-res-ext", "—");
      afficher("tv-res-ret", "—");
      afficher("tv-note", "");
    }

    // 10. Diamètre de conduite : d = √(21,2 × Q / vmax)
    const diQ = lire("di-q");
    const diLigne = document.getElementById("di-ligne") as HTMLSelectElement | null;
    const diVmax = diLigne ? parseFloat(diLigne.value) : NaN;
    afficher(
      "di-res",
      diQ >= 0 && diVmax > 0 ? `${fmtFr(Math.sqrt((21.2 * diQ) / diVmax), 1)} mm` : "—"
    );

    // 11. Accumulateur : les cinq grandeurs sont liées par une seule relation
    //     ΔV = V₀ × p₀ × (1/p_min − 1/p_max), en pressions ABSOLUES (= relatives + 1).
    //     Connaître quatre d'entre elles suffit donc toujours à trouver la
    //     cinquième : le sélecteur choisit laquelle est l'inconnue.
    //     Le cycle adiabatique (exposant 1,4) ne s'inverse pas analytiquement :
    //     il n'est affiché que dans le sens direct.
    const acInconnueEl = document.getElementById("ac-inconnue") as HTMLSelectElement | null;
    const acInconnue = acInconnueEl?.value ?? "dv";
    const acV0 = lire("ac-v0"), acP0 = lire("ac-p0");
    const acPmin = lire("ac-pmin"), acPmax = lire("ac-pmax"), acDv = lire("ac-dv");
    // Pressions absolues
    const p0a = acP0 + 1, pMinA = acPmin + 1, pMaxA = acPmax + 1;
    const ecartInverse = 1 / pMinA - 1 / pMaxA;

    afficher("ac-label-iso", acInconnue === "dv"
      ? "Volume utile (cycle lent, isotherme)"
      : { v0: "Volume d'accumulateur nécessaire", p0: "Pression de gonflage à retenir",
          pmin: "Pression de service mini", pmax: "Pression de service maxi" }[acInconnue] ?? "Résultat");

    let acValeur = NaN, acUnite = "L", acAlerte = "";
    if (acInconnue === "dv") {
      if (acV0 > 0 && p0a < pMinA && pMinA < pMaxA) acValeur = acV0 * p0a * ecartInverse;
      else acAlerte = "⚠️ Il faut respecter p₀ < p mini < p maxi.";
    } else if (acInconnue === "v0") {
      if (acDv > 0 && p0a < pMinA && pMinA < pMaxA) acValeur = acDv / (p0a * ecartInverse);
      else acAlerte = "⚠️ Il faut un volume utile positif et respecter p₀ < p mini < p maxi.";
    } else if (acInconnue === "p0") {
      acUnite = "bar";
      if (acDv > 0 && acV0 > 0 && pMinA < pMaxA) {
        const p0Calc = acDv / (acV0 * ecartInverse);
        acValeur = p0Calc - 1;
        if (p0Calc >= pMinA) acAlerte = "⚠️ Impossible : il faudrait gonfler au-dessus de la pression mini de service. Prenez un accumulateur plus grand ou un volume utile plus faible.";
      } else acAlerte = "⚠️ Renseignez le volume utile, le volume d'accumulateur, et p mini < p maxi.";
    } else if (acInconnue === "pmin") {
      acUnite = "bar";
      if (acDv > 0 && acV0 > 0 && p0a > 0 && pMaxA > 0) {
        const inverse = acDv / (acV0 * p0a) + 1 / pMaxA;
        const pMinCalc = 1 / inverse;
        acValeur = pMinCalc - 1;
        if (pMinCalc <= p0a) acAlerte = "⚠️ Résultat sous la pression de gonflage : ce volume utile est hors de portée de cet accumulateur.";
      } else acAlerte = "⚠️ Renseignez le volume utile, le volume d'accumulateur et la pression maxi.";
    } else if (acInconnue === "pmax") {
      acUnite = "bar";
      if (acDv > 0 && acV0 > 0 && p0a > 0 && pMinA > 0) {
        const inverse = 1 / pMinA - acDv / (acV0 * p0a);
        if (inverse > 0) {
          acValeur = 1 / inverse - 1;
        } else {
          acAlerte = "⚠️ Ce volume utile est impossible avec ce gonflage : l'accumulateur serait entièrement vidé avant d'atteindre la pression maxi. Augmentez V₀ ou p₀.";
        }
      } else acAlerte = "⚠️ Renseignez le volume utile, le volume d'accumulateur et la pression mini.";
    }

    if (Number.isFinite(acValeur) && acValeur > 0 && !acAlerte) {
      afficher("ac-res-iso", `${fmtFr(acValeur, acUnite === "L" ? 2 : 1)} ${acUnite}`);
      // Le gonflage conseillé vaut environ 0,9 × p mini : on le rappelle quand
      // c'est justement p₀ que l'on cherche.
      afficher("ac-verdict", acInconnue === "p0"
        ? `Repère : le gonflage conseillé est d'environ 0,9 × p mini, soit ${fmtFr(0.9 * acPmin, 0)} bar ici.`
        : "");
    } else {
      afficher("ac-res-iso", "—");
      afficher("ac-verdict", acAlerte);
    }

    // Volume utile en cycle rapide : seulement dans le sens direct.
    const blocAdia = document.getElementById("ac-bloc-adia");
    if (acInconnue === "dv") {
      blocAdia?.removeAttribute("hidden");
      if (acV0 > 0 && p0a < pMinA && pMinA < pMaxA) {
        afficher("ac-res-adia", `${fmtFr(acV0 * ((p0a / pMinA) ** (1 / 1.4) - (p0a / pMaxA) ** (1 / 1.4)), 2)} L`);
      } else {
        afficher("ac-res-adia", "—");
      }
    } else {
      blocAdia?.setAttribute("hidden", "");
    }


    // 12. Vitesse d'un moteur hydraulique : N = Q × 1000 × ηv / Cyl
    const moQ = lire("mo-q"), moCyl = lire("mo-cyl"), moRv = lire("mo-rv");
    afficher(
      "mo-res",
      moQ >= 0 && moCyl > 0 && moRv >= 0
        ? `${fmtFr((moQ * 1000 * (moRv / 100)) / moCyl, 0)} tr/min`
        : "—"
    );

    // 13. Pertes de charge (Darcy-Weisbach) : Δp = λ × (L/d) × ρ v² / 2
    // λ = 64/Re en laminaire ; corrélation de Blasius au-delà, valable jusqu'à
    // environ Re = 100 000 pour un tube lisse.
    const peQ = lire("pe-q"), peD = lire("pe-d"), peL = lire("pe-l");
    const peNu = lire("pe-nu"), peRho = lire("pe-rho");
    if (peQ > 0 && peD > 0 && peL >= 0 && peNu > 0 && peRho > 0) {
      const vPe = peQ / 60000 / sectionM2(peD);
      const rePe = (1000 * vPe * peD) / peNu;
      const laminaire = rePe < 2300;
      const lambda = laminaire ? 64 / rePe : 0.3164 / rePe ** 0.25;
      const dpBar = (lambda * (peL / (peD / 1000)) * peRho * vPe ** 2) / 2 / 1e5;
      afficher("pe-res", `${fmtFr(dpBar, 2)} bar`);
      afficher("pe-res-p", `${fmtFr((peQ * dpBar) / 600, 3)} kW`);
      afficher(
        "pe-note",
        `Vitesse ${fmtFr(vPe, 2)} m/s · Re ${fmtFr(rePe, 0)} · régime ${laminaire ? "laminaire" : "turbulent"} · λ = ${fmtFr(lambda, 4)}.`
      );
      let verdictPe = "";
      if (dpBar > 10) verdictPe = "⚠️ Perte de charge très élevée : augmentez le diamètre ou raccourcissez la ligne, sinon l'échauffement sera important.";
      else if (dpBar > 3) verdictPe = "🟠 Perte de charge notable : acceptable sur une ligne de pression courte, à revoir sur un retour ou une aspiration.";
      else verdictPe = "✅ Perte de charge modérée.";
      if (rePe > 100000) verdictPe += " Attention : au-delà de Re = 100 000, la corrélation de Blasius sous-estime les pertes.";
      afficher("pe-verdict", verdictPe);
    } else {
      afficher("pe-res", "—");
      afficher("pe-res-p", "—");
      afficher("pe-note", "");
      afficher("pe-verdict", "");
    }

    // 14. Diamètre de gicleur : Q = Cd × A × √(2Δp/ρ), inversé pour trouver A.
    // La viscosité de l'huile choisie à la température saisie sert à vérifier
    // que l'on reste en régime turbulent, seul cas où Cd est constant.
    const giQ = lire("gi-q"), giDp = lire("gi-dp"), giT = lireLibre("gi-t");
    const giCdEl = document.getElementById("gi-cd") as HTMLSelectElement | null;
    const giCd = giCdEl ? parseFloat(giCdEl.value) : NaN;
    const giSelect = document.getElementById("gi-huile") as HTMLSelectElement | null;
    const giOption = giSelect?.selectedOptions[0];
    const giFam = giOption && !giOption.disabled ? giOption.dataset.fam ?? "" : "";
    const giNu = viscositeA(lire("gi-n1"), lire("gi-n2"), giT);
    if (giQ > 0 && giDp > 0 && giCd > 0 && giFam && Number.isFinite(giNu) && giNu > 0) {
      const rhoGi = masseVolumiqueA(giFam, giT);
      const vTheo = Math.sqrt((2 * giDp * 1e5) / rhoGi);
      const aireGi = giQ / 60000 / (giCd * vTheo);
      const dGi = Math.sqrt((4 * aireGi) / Math.PI) * 1000;
      const vGi = giCd * vTheo;
      const reGi = (1000 * vGi * dGi) / giNu;
      afficher("gi-res", `${fmtFr(dGi, 2)} mm`);
      afficher("gi-res-v", `${fmtFr(vGi, 0)} m/s`);
      afficher(
        "gi-fiche-calc",
        `Huile à ${fmtFr(giT, 0)} °C : ν = ${fmtFr(giNu, 1)} cSt · ρ ≈ ${fmtFr(rhoGi, 0)} kg/m³ · Re dans l'orifice ≈ ${fmtFr(reGi, 0)}.`
      );
      afficher("gi-verdict", verdictOrifice(reGi));
      afficher(
        "gi-alerte",
        dGi < 0.3
          ? "⚠️ Diamètre inférieur à 0,3 mm : très sensible au colmatage. Prévoyez une filtration fine en amont, ou répartissez le débit sur plusieurs orifices."
          : ""
      );
    } else {
      afficher("gi-res", "—");
      afficher("gi-res-v", "—");
      afficher("gi-fiche-calc", "");
      afficher("gi-verdict", "");
      afficher("gi-alerte", "");
    }

    // 15. Débit à travers un orifice existant : Q = Cd × A × √(2Δp/ρ)
    const orD = lire("or-d"), orDp = lire("or-dp");
    const orNu = lire("or-nu"), orRho = lire("or-rho");
    const orCdEl = document.getElementById("or-cd") as HTMLSelectElement | null;
    const orCd = orCdEl ? parseFloat(orCdEl.value) : NaN;
    if (orD > 0 && orDp > 0 && orNu > 0 && orRho > 0 && orCd > 0) {
      const aireOr = sectionM2(orD);
      const vOr = orCd * Math.sqrt((2 * orDp * 1e5) / orRho);
      const qOr = vOr * aireOr * 60000;
      const reOr = (1000 * vOr * orD) / orNu;
      afficher("or-res", `${fmtFr(qOr, 2)} L/min`);
      afficher("or-res-v", `${fmtFr(vOr, 0)} m/s`);
      afficher("or-note", `Section de passage ${fmtFr(aireOr * 1e6, 3)} mm² · Re dans l'orifice ≈ ${fmtFr(reOr, 0)}.`);
      afficher("or-verdict", verdictOrifice(reOr));
    } else {
      afficher("or-res", "—");
      afficher("or-res-v", "—");
      afficher("or-note", "");
      afficher("or-verdict", "");
    }

    // 16. Bilan thermique global : la puissance perdue par l'ensemble du groupe
    // (1 − rendement global), ou une valeur mesurée, est évacuée par les parois
    // du réservoir. Au-delà de ce que celles-ci encaissent, il faut un échangeur.
    const btModeEl = document.getElementById("bt-mode") as HTMLSelectElement | null;
    const btDirect = btModeEl?.value === "direct";
    const btQ = lire("bt-q"), btP = lire("bt-p"), btEta = lire("bt-eta");
    const btV = lire("bt-v"), btTamb = lireLibre("bt-tamb"), btTcible = lireLibre("bt-tcible");
    const btKEl = document.getElementById("bt-k") as HTMLSelectElement | null;
    const btK = btKEl ? parseFloat(btKEl.value) : NaN;
    // Puissance dissipée en watts, selon le mode choisi.
    const btPdiss = btDirect
      ? lire("bt-pdiss") * 1000
      : btQ > 0 && btP > 0 && btEta > 0 && btEta < 100
        ? ((btQ * btP) / 600) * 1000 * (1 - btEta / 100)
        : NaN;
    if (
      Number.isFinite(btPdiss) && btPdiss >= 0 && btV > 0 && btK > 0 &&
      Number.isFinite(btTamb) && Number.isFinite(btTcible)
    ) {
      const surfaceBt = surfaceReservoir(btV);
      const evacuation = btK * surfaceBt; // W par degré au-dessus de l'ambiante
      const tEqBt = btTamb + btPdiss / evacuation;
      const pEchangeur = btPdiss - evacuation * (btTcible - btTamb);
      afficher("bt-res-pdiss", `${fmtFr(btPdiss / 1000, 2)} kW`);
      afficher("bt-res-teq", `${fmtFr(tEqBt, 0)} °C`);
      afficher("bt-res-echangeur", pEchangeur > 0 ? `${fmtFr(pEchangeur / 1000, 2)} kW` : "aucun");
      afficher(
        "bt-note",
        `Surface d'échange estimée ${fmtFr(surfaceBt, 1)} m² · le réservoir évacue ${fmtFr(evacuation, 0)} W par degré au-dessus de l'ambiante.`
      );
      if (btTcible <= btTamb) {
        afficher("bt-verdict", "⚠️ La température visée doit être supérieure à la température ambiante : le réservoir ne peut pas refroidir l'huile en dessous de l'air qui l'entoure.");
      } else if (pEchangeur <= 0) {
        afficher(
          "bt-verdict",
          `✅ L'huile se stabilise vers ${fmtFr(tEqBt, 0)} °C, sous la cible de ${fmtFr(btTcible, 0)} °C : le réservoir suffit, pas d'échangeur nécessaire.`
        );
      } else {
        afficher(
          "bt-verdict",
          `⚠️ Sans échangeur, l'huile monterait vers ${fmtFr(tEqBt, 0)} °C. Pour tenir ${fmtFr(btTcible, 0)} °C, prévoyez un refroidisseur d'au moins ${fmtFr(pEchangeur / 1000, 2)} kW (${fmtFr(pEchangeur, 0)} W).`
        );
      }
    } else {
      afficher("bt-res-pdiss", "—");
      afficher("bt-res-teq", "—");
      afficher("bt-res-echangeur", "—");
      afficher("bt-note", "");
      afficher("bt-verdict", "");
    }

    // 17. Échauffement : P = Q × Δp / 600, puis équilibre thermique du
    // réservoir P = k × S × ΔT.
    const ecQ = lire("ec-q"), ecDp = lire("ec-dp"), ecV = lire("ec-v");
    const ecTa = lireLibre("ec-ta");
    const ecKEl = document.getElementById("ec-k") as HTMLSelectElement | null;
    const ecK = ecKEl ? parseFloat(ecKEl.value) : NaN;
    if (ecQ >= 0 && ecDp >= 0 && ecV > 0 && ecK > 0 && Number.isFinite(ecTa)) {
      const pKw = (ecQ * ecDp) / 600;
      const surface = surfaceReservoir(ecV);
      const deltaT = (pKw * 1000) / (ecK * surface);
      const tEq = ecTa + deltaT;
      afficher("ec-res", `${fmtFr(pKw, 2)} kW`);
      afficher("ec-res-t", `${fmtFr(tEq, 0)} °C`);
      afficher(
        "ec-note",
        `Surface d'échange estimée ${fmtFr(surface, 1)} m² · élévation de ${fmtFr(deltaT, 0)} °C au-dessus de l'ambiante.`
      );
      let verdictEc = "";
      if (tEq <= 50) verdictEc = "✅ Le réservoir évacue seul cette chaleur : pas de refroidisseur nécessaire.";
      else if (tEq <= 60) verdictEc = "🟠 Température de service haute mais tenable. Surveillez-la en été et vérifiez la viscosité atteinte.";
      else if (tEq <= 70) verdictEc = "⚠️ Trop chaud : vieillissement accéléré de l'huile et des joints. Un échangeur est conseillé.";
      else if (tEq <= 90) verdictEc = "⚠️ Un échangeur est indispensable : à cette température, l'huile s'oxyde vite et le film lubrifiant devient insuffisant.";
      else verdictEc = "⚠️ Cette température d'équilibre est théorique : en pratique elle n'est jamais atteinte, car l'huile et les joints se dégradent bien avant. À retenir simplement : le réservoir seul est très loin de suffire, un échangeur dimensionné pour la puissance dissipée ci-dessus est obligatoire.";
      afficher("ec-verdict", verdictEc);
    } else {
      afficher("ec-res", "—");
      afficher("ec-res-t", "—");
      afficher("ec-note", "");
      afficher("ec-verdict", "");
    }

    // 18. Moteur d'entraînement : P_moteur = P_hyd / η, puis C = 9550 P / N
    const meQ = lire("me-q"), meP = lire("me-p"), meEta = lire("me-eta"), meN = lire("me-n");
    if (meQ >= 0 && meP >= 0 && meEta > 0 && meEta <= 100) {
      const pHyd = (meQ * meP) / 600;
      const pMot = pHyd / (meEta / 100);
      afficher("me-res-hyd", `${fmtFr(pHyd, 2)} kW`);
      afficher("me-res-mot", `${fmtFr(pMot, 2)} kW`);
      afficher("me-res-couple", meN > 0 ? `${fmtFr((9550 * pMot) / meN, 1)} Nm` : "—");
      // Série des puissances normalisées CEI : on ne commande pas 25,3 kW.
      const normalisees = [0.75, 1.1, 1.5, 2.2, 3, 4, 5.5, 7.5, 11, 15, 18.5, 22, 30, 37, 45, 55, 75];
      const retenue = normalisees.find((p) => p >= pMot);
      afficher(
        "me-verdict",
        retenue
          ? `Prévoir un moteur normalisé de ${fmtFr(retenue, 1)} kW${meN > 0 ? ` à ${fmtFr(meN, 0)} tr/min` : ""}, et garder de la marge pour le démarrage à froid.`
          : "Au-delà de la série normalisée courante : à traiter avec le constructeur."
      );
    } else {
      afficher("me-res-hyd", "—");
      afficher("me-res-mot", "—");
      afficher("me-res-couple", "—");
      afficher("me-verdict", "");
    }

    // 19. Moteur électrique asynchrone : vitesse de synchronisme, couple, courant
    const elP = lire("el-p"), elF = lire("el-f"), elG = lire("el-g");
    const elU = lire("el-u"), elCos = lire("el-cos"), elEta = lire("el-eta");
    const elPolesEl = document.getElementById("el-poles") as HTMLSelectElement | null;
    const elPoles = elPolesEl ? parseFloat(elPolesEl.value) : NaN;
    if (elP > 0 && elF > 0 && elPoles > 0 && elG >= 0 && elG < 100) {
      const nSync = (120 * elF) / elPoles;
      const nReel = nSync * (1 - elG / 100);
      afficher("el-res-n", `${fmtFr(nReel, 0)} tr/min`);
      afficher("el-res-couple", nReel > 0 ? `${fmtFr((9550 * elP) / nReel, 1)} Nm` : "—");
      if (elU > 0 && elCos > 0 && elEta > 0) {
        const courant = (elP * 1000) / (Math.sqrt(3) * elU * elCos * (elEta / 100));
        afficher("el-res-i", `${fmtFr(courant, 1)} A`);
        afficher(
          "el-note",
          `Vitesse de synchronisme ${fmtFr(nSync, 0)} tr/min. Au démarrage direct, le courant atteint ${fmtFr(courant * 5, 0)} à ${fmtFr(courant * 7, 0)} A ; en étoile-triangle, environ ${fmtFr(courant * 2, 0)} A — mais le couple de démarrage est divisé par trois.`
        );
      } else {
        afficher("el-res-i", "—");
        afficher("el-note", `Vitesse de synchronisme ${fmtFr(nSync, 0)} tr/min.`);
      }
    } else {
      afficher("el-res-n", "—");
      afficher("el-res-couple", "—");
      afficher("el-res-i", "—");
      afficher("el-note", "");
    }

    // 20. Choix d'un moteur hydraulique : cylindrée et débit nécessaires
    const cmC = lire("cm-c"), cmN = lire("cm-n"), cmDp = lire("cm-dp");
    const cmRm = lire("cm-rm"), cmRv = lire("cm-rv");
    if (cmC > 0 && cmN > 0 && cmDp > 0 && cmRm > 0 && cmRv > 0) {
      const cylindree = (cmC * 20 * Math.PI) / (cmDp * (cmRm / 100));
      const debit = (cylindree * cmN) / (1000 * (cmRv / 100));
      const puissance = (cmC * 2 * Math.PI * cmN) / 60 / 1000;
      afficher("cm-res-cyl", `${fmtFr(cylindree, 1)} cm³/tr`);
      afficher("cm-res-q", `${fmtFr(debit, 1)} L/min`);
      afficher("cm-res-p", `${fmtFr(puissance, 2)} kW`);
      // Orientation par famille : la vitesse visée est le premier discriminant,
      // le couple le second. Ce sont des domaines d'emploi, pas des limites.
      let famille = "";
      if (cmN < 100) {
        famille = "🐌 Moteur lent à came (pistons radiaux) : entraînement direct sans réducteur, fort couple à très basse vitesse.";
      } else if (cmN > 1200 && cmC < 100) {
        famille = "⚡ Moteur à engrenages : rapide, couple modeste, économique et robuste — le choix par défaut sur engin mobile.";
      } else if (cmC > 300 || cmDp > 250) {
        famille = "🔩 Moteur à pistons : couple élevé, haute pression, meilleur rendement — plus coûteux et sensible à la pression de retour.";
      } else {
        famille = "🌀 Moteur à palettes ou à pistons : domaine intermédiaire, fonctionnement silencieux et régulier.";
      }
      afficher("cm-verdict", famille);
    } else {
      afficher("cm-res-cyl", "—");
      afficher("cm-res-q", "—");
      afficher("cm-res-p", "—");
      afficher("cm-verdict", "");
    }

    // 21. Flambage de tige (Euler) : F_crit = π² E I / Lf², en système MPa/mm
    // pour éviter toute conversion (E en MPa, I en mm⁴, résultat en newtons).
    const flD = lire("fl-d"), flL = lire("fl-l"), flS = lire("fl-s"), flF = lire("fl-f");
    const flMuEl = document.getElementById("fl-mu") as HTMLSelectElement | null;
    const flMu = flMuEl ? parseFloat(flMuEl.value) : NaN;
    if (flD > 0 && flL > 0 && flMu > 0 && flS >= 1) {
      const inertie = (Math.PI * flD ** 4) / 64;
      const longueurFlambage = flMu * flL;
      const fCrit = (Math.PI ** 2 * 210000 * inertie) / longueurFlambage ** 2;
      const fAdm = fCrit / flS;
      afficher("fl-res-crit", `${fmtFr(fCrit / 1000, 1)} kN`);
      afficher("fl-res-adm", `${fmtFr(fAdm / 1000, 1)} kN`);
      const fService = flF * 1000;
      if (flF > 0) {
        afficher(
          "fl-verdict",
          fService <= fAdm
            ? `✅ Tige suffisante : la charge de service représente ${fmtFr((fService / fAdm) * 100, 0)} % de l'admissible, soit une marge de ${fmtFr(fAdm / fService, 1)}×.`
            : `⚠️ Risque de flambage : ${fmtFr(flF, 0)} kN demandés pour ${fmtFr(fAdm / 1000, 1)} kN admissibles. Augmentez le diamètre de tige, réduisez la course libre, ou choisissez un montage moins défavorable.`
        );
      } else {
        afficher("fl-verdict", `Longueur de flambage retenue : ${fmtFr(longueurFlambage, 0)} mm (μ × longueur libre).`);
      }
    } else {
      afficher("fl-res-crit", "—");
      afficher("fl-res-adm", "—");
      afficher("fl-verdict", "");
    }

    // 22. Rigidité hydraulique : k = β A² / V, avec V = A × L, donc k = β A / L.
    const rgD = lire("rg-d"), rgL = lire("rg-l"), rgM = lire("rg-m"), rgBeta = lire("rg-beta");
    if (rgD > 0 && rgL > 0 && rgBeta > 0) {
      const aire = sectionM2(rgD);
      const raideur = (rgBeta * 1e6 * aire) / (rgL / 1000); // N/m
      afficher("rg-res-k", `${fmtFr(raideur / 1e6, 1)} kN/mm`);
      if (rgM > 0) {
        const frequence = Math.sqrt(raideur / rgM) / (2 * Math.PI);
        afficher("rg-res-f", `${fmtFr(frequence, 1)} Hz`);
        let verdictRg = "";
        if (frequence < 10) {
          verdictRg = `⚠️ Système mou (moins de 10 Hz) : sujet aux oscillations et aux à-coups. Raccourcissez la colonne d'huile ou augmentez la section du vérin.`;
        } else {
          verdictRg = `La bande passante d'un asservissement doit rester sous ${fmtFr(frequence / 3, 0)} Hz, soit le tiers de la fréquence propre.`;
        }
        afficher("rg-verdict", verdictRg);
      } else {
        afficher("rg-res-f", "—");
        afficher("rg-verdict", "");
      }
    } else {
      afficher("rg-res-k", "—");
      afficher("rg-res-f", "—");
      afficher("rg-verdict", "");
    }

    // 23. Pertes dans les accessoires : Δp = K_total × ρ v² / 2
    const paQ = lire("pa-q"), paD = lire("pa-d"), paRho = lire("pa-rho");
    const accessoires: [string, number][] = [
      ["pa-coude90", 0.9], ["pa-coude45", 0.4], ["pa-te", 0.4],
      ["pa-te-der", 1.3], ["pa-raccord", 0.1], ["pa-reservoir", 0.75],
    ];
    const kTotal =
      accessoires.reduce((somme, [id, k]) => somme + (lire(id) || 0) * k, 0) +
      (lire("pa-autre-k") || 0) * (lire("pa-autre-n") || 0);
    if (paQ > 0 && paD > 0 && paRho > 0) {
      const vPa = paQ / 60000 / sectionM2(paD);
      const dpPa = (kTotal * paRho * vPa ** 2) / 2 / 1e5;
      afficher("pa-res-k", fmtFr(kTotal, 2));
      afficher("pa-res-dp", `${fmtFr(dpPa, 3)} bar`);
      afficher(
        "pa-note",
        `Vitesse dans la conduite ${fmtFr(vPa, 2)} m/s · puissance perdue ${fmtFr((paQ * dpPa) / 600, 3)} kW. À additionner à la perte en conduite droite.`
      );
    } else {
      afficher("pa-res-k", "—");
      afficher("pa-res-dp", "—");
      afficher("pa-note", "");
    }

    // 24. Réservoir : V = k × Q, règle usuelle de 3 à 5 fois le débit par minute
    const rsQ = lire("rs-q");
    const rsKEl = document.getElementById("rs-k") as HTMLSelectElement | null;
    const rsK = rsKEl ? parseFloat(rsKEl.value) : NaN;
    if (rsQ > 0 && rsK > 0) {
      afficher("rs-res", `${fmtFr(rsQ * rsK, 0)} L`);
      afficher(
        "rs-note",
        `Fourchette conseillée : ${fmtFr(rsQ * 3, 0)} à ${fmtFr(rsQ * 5, 0)} L. Le volume retenu ici est ${fmtFr(rsK, 0)} × le débit. Vérifiez-le ensuite au bilan thermique : c'est la chaleur, pas le débit, qui décide vraiment.`
      );
    } else {
      afficher("rs-res", "—");
      afficher("rs-note", "");
    }

    // 25. Thermoplongeur : énergie de chauffe, maintien, et densité surfacique.
    // Une épingle est un tube plié en U : ses deux branches chauffent, d'où le
    // facteur 2 sur la profondeur immergée.
    const tpV = lire("tp-v"), tpRho = lire("tp-rho"), tpC = lire("tp-c");
    const tpTdep = lireLibre("tp-tdep"), tpTcible = lireLibre("tp-tcible");
    const tpDuree = lire("tp-duree"), tpTamb = lireLibre("tp-tamb");
    const tpD = lire("tp-d"), tpL = lire("tp-l"), tpN = lire("tp-n");
    const tpKEl = document.getElementById("tp-k") as HTMLSelectElement | null;
    const tpK = tpKEl ? parseFloat(tpKEl.value) : NaN;
    const tpTypeEl = document.getElementById("tp-type") as HTMLSelectElement | null;
    const tpBarillet = tpTypeEl?.value === "barillet";
    if (
      tpV > 0 && tpRho > 0 && tpC > 0 && tpDuree > 0 && tpK > 0 &&
      Number.isFinite(tpTdep) && Number.isFinite(tpTcible) && Number.isFinite(tpTamb) &&
      tpTcible > tpTdep
    ) {
      const pChauffe = (tpV * tpRho * tpC * (tpTcible - tpTdep)) / (3600 * tpDuree);
      const surfaceTp = surfaceReservoir(tpV);
      const pMaintien = Math.max(0, (tpK * surfaceTp * (tpTcible - tpTamb)) / 1000);
      const pTotale = pChauffe + pMaintien;
      afficher("tp-res-chauffe", `${fmtFr(pChauffe, 2)} kW`);
      afficher("tp-res-maintien", `${fmtFr(pMaintien, 2)} kW`);
      afficher("tp-res-total", `${fmtFr(pTotale, 2)} kW`);
      if (tpD > 0 && tpL > 0 && tpN > 0) {
        // Surface chauffante en cm² : π × d × (2 × profondeur) × nombre d'épingles
        const surfaceChauffante = Math.PI * (tpD / 10) * ((2 * tpL) / 10) * tpN;
        const densite = (pTotale * 1000) / surfaceChauffante;
        afficher("tp-res-densite", `${fmtFr(densite, 2)} W/cm²`);
        afficher(
          "tp-note",
          `Surface chauffante ${fmtFr(surfaceChauffante, 0)} cm² (${fmtFr(tpN, 0)} épingles, deux branches chacune) · surface d'échange du réservoir ${fmtFr(surfaceTp, 1)} m².`
        );
        let verdictTp = "";
        if (densite <= 1) verdictTp = "✅ Densité de puissance sans risque pour une huile minérale : le film au contact de l'élément reste à température acceptable.";
        else if (densite <= 1.5) verdictTp = "🟠 Densité élevée : acceptable seulement si la circulation d'huile devant l'élément est assurée. Surveillez l'apparition de vernis.";
        else verdictTp = "⚠️ Densité trop forte : l'huile va craquer au contact de l'élément (vernis, colmatage des filtres). Rallongez les épingles, augmentez leur nombre ou leur diamètre — n'augmentez pas la puissance.";
        afficher("tp-verdict", verdictTp);
      } else {
        afficher("tp-res-densite", "—");
        afficher("tp-note", `Surface d'échange du réservoir ${fmtFr(surfaceTp, 1)} m².`);
        afficher("tp-verdict", "");
      }
      afficher(
        "tp-type-note",
        tpBarillet
          ? "ℹ️ Thermoplongeur à barillet : le fourreau ajoute une résistance thermique entre la résistance et l'huile, donc l'élément travaille plus chaud à puissance égale. La densité admissible est plus basse qu'en immersion directe — les seuils ci-dessus ne s'y appliquent pas tels quels, demandez la valeur au fabricant."
          : ""
      );
    } else {
      afficher("tp-res-chauffe", "—");
      afficher("tp-res-maintien", "—");
      afficher("tp-res-total", "—");
      afficher("tp-res-densite", "—");
      afficher("tp-note", "");
      afficher("tp-verdict", Number.isFinite(tpTcible) && Number.isFinite(tpTdep) && tpTcible <= tpTdep
        ? "⚠️ La température visée doit être supérieure à la température de départ."
        : "");
      afficher("tp-type-note", "");
    }
  };

  // Sélecteur d'huile, partagé par le calculateur de viscosité (préfixe « vi »)
  // et celui du diamètre de gicleur (préfixe « gi »). Il remplit les deux champs
  // de viscosité (40 °C / 100 °C) que les calculs utilisent, et affiche la fiche
  // technique. La fiche détaillée par famille (domaine, avantages, points de
  // vigilance, joints) n'existe que sur la carte viscosité : elle n'est remplie
  // que si le conteneur correspondant est présent.
  const majHuile = (p = "vi") => {
    const select = document.getElementById(`${p}-huile`) as HTMLSelectElement | null;
    const champN1 = document.getElementById(`${p}-n1`) as HTMLInputElement | null;
    const champN2 = document.getElementById(`${p}-n2`) as HTMLInputElement | null;
    const option = select?.selectedOptions[0];
    if (!select || !champN1 || !champN2 || !option || option.disabled) {
      afficher(`${p}-fiche`, "");
      afficherHTML(`${p}-info`, "");
      return;
    }
    const [n40, n100] = select.value.split("|").map(Number);
    champN1.value = String(n40);
    champN2.value = String(n100);
    const vi = option.dataset.vi;
    const fam = option.dataset.fam ?? "";
    const info = infosFamille[fam as keyof typeof infosFamille];
    // Les huiles « Standard » ne sont pas un produit du commerce : le dire, pour
    // qu'on ne les prenne pas pour une fiche technique de fabricant.
    const echantillon = option.dataset.echantillon;
    const valeurs = `${fmtFr(n40, 1)} cSt à 40 °C · ${fmtFr(n100, 2)} cSt à 100 °C · VI ${vi} — ${info?.label ?? fam}`;
    afficher(
      `${p}-fiche`,
      echantillon
        ? `Valeurs représentatives : ${valeurs}. Huile générique, établie d'après ${echantillon} huiles réelles du catalogue de ce type et de ce grade — à remplacer par la fiche technique du fabricant dès que la marque est connue.`
        : `Fiche technique : ${valeurs}.`
    );
    if (info && document.getElementById(`${p}-info`)) {
      afficherHTML(
        `${p}-info`,
        `
        <p><span class="calc-huile-badge">Domaine d'application</span>${info.domaine}</p>
        <div class="calc-huile-avinc">
          <div>
            <h3>Avantages</h3>
            <ul class="calc-huile-avantages">${listeHTML(info.avantages)}</ul>
          </div>
          <div>
            <h3>Points de vigilance</h3>
            <ul class="calc-huile-inconvenients">${listeHTML(info.inconvenients)}</ul>
          </div>
        </div>
        <p><span class="calc-huile-badge">Joints</span>${info.joints}</p>
        <p><span class="calc-huile-badge">À retenir</span>${info.autre}</p>
        `
      );
    } else {
      afficherHTML(`${p}-info`, "");
    }
  };

  // Reconstruit la liste déroulante « Huile » à partir des trois filtres
  // (marque, type, viscosité à 40 °C), en conservant la sélection en cours
  // si elle correspond toujours aux filtres actifs.
  const construireOptionsHuiles = (p = "vi") => {
    const select = document.getElementById(`${p}-huile`) as HTMLSelectElement | null;
    if (!select) return;
    const valeurAvant = select.value;
    const fMarque = (document.getElementById(`${p}-filtre-marque`) as HTMLSelectElement | null)?.value ?? "";
    const fType = (document.getElementById(`${p}-filtre-type`) as HTMLSelectElement | null)?.value ?? "";
    const fVg = (document.getElementById(`${p}-filtre-vg`) as HTMLSelectElement | null)?.value ?? "";

    const filtrees = catalogue.filter(
      (h) =>
        (!fMarque || h.marque === fMarque) &&
        (!fType || h.fam === fType) &&
        (!fVg || h.vg === fVg)
    );

    afficher(
      `${p}-nb-resultats`,
      filtrees.length === catalogue.length
        ? ""
        : `${filtrees.length} huile${filtrees.length > 1 ? "s" : ""} correspondant aux filtres.`
    );

    select.innerHTML = "";
    if (filtrees.length === 0) {
      const opt = document.createElement("option");
      opt.textContent = "Aucune huile ne correspond à ces filtres";
      opt.disabled = true;
      opt.selected = true;
      select.appendChild(opt);
      return;
    }

    const marquesFiltrees = [...new Set(filtrees.map((h) => h.marque))];
    marquesFiltrees.forEach((marque) => {
      const groupe = document.createElement("optgroup");
      groupe.label = marque;
      filtrees
        .filter((h) => h.marque === marque)
        .forEach((h) => {
          const opt = document.createElement("option");
          opt.value = `${h.n40}|${h.n100}`;
          opt.dataset.vi = String(h.vi);
          opt.dataset.fam = h.fam;
          if (h.echantillon) opt.dataset.echantillon = String(h.echantillon);
          opt.textContent = libelleHuile(h);
          groupe.appendChild(opt);
        });
      select.appendChild(groupe);
    });

    const optionConservee = Array.from(select.options).find((o) => o.value === valeurAvant);
    select.value = optionConservee ? valeurAvant : select.options[0].value;
  };

  // Bilan thermique : n'afficher que les champs du mode de saisie choisi —
  // estimation par le rendement, ou puissance dissipée déjà connue par mesure.
  const majModeBilan = () => {
    const direct = (document.getElementById("bt-mode") as HTMLSelectElement | null)?.value === "direct";
    document.getElementById("bt-champs-rendement")?.toggleAttribute("hidden", direct);
    document.getElementById("bt-champs-direct")?.toggleAttribute("hidden", !direct);
  };

  // Accumulateur : la grandeur choisie comme inconnue devient un résultat, donc
  // on masque son champ de saisie et on affiche celui du volume utile.
  const majInconnueAccu = () => {
    const inconnue = (document.getElementById("ac-inconnue") as HTMLSelectElement | null)?.value ?? "dv";
    ["dv", "v0", "p0", "pmin", "pmax"].forEach((grandeur) => {
      const champ = document.getElementById(`ac-champ-${grandeur}`);
      // Le champ ΔV n'apparaît que lorsqu'il est une donnée d'entrée.
      const masque = grandeur === "dv" ? inconnue === "dv" : inconnue === grandeur;
      champ?.toggleAttribute("hidden", masque);
    });
  };

  /** Conversions d'unités : chaque champ connaît sa cible et son facteur. */
  const convertirDepuis = (champ: HTMLInputElement) => {
    const cible = document.getElementById(champ.dataset.vers ?? "") as HTMLInputElement | null;
    if (!cible) return;
    const valeur = parseFloat(champ.value);
    if (!Number.isFinite(valeur)) { cible.value = ""; return; }
    const facteur = parseFloat(champ.dataset.facteur ?? "1");
    const decalage = parseFloat(champ.dataset.offset ?? "0");
    const resultat = valeur * facteur + decalage;
    // Arrondi à 6 chiffres significatifs : au-delà, c'est du bruit de calcul.
    cible.value = String(Number(resultat.toPrecision(6)));
    if (champ.id === "cv-cst" || champ.id === "cv-sus") {
      const cSt = champ.id === "cv-cst" ? valeur : resultat;
      afficher(
        "cv-note",
        cSt < 70
          ? "⚠️ Sous 70 cSt, la relation cSt ↔ SUS n'est plus linéaire : ce facteur devient approximatif. Utilisez la table ASTM D2161 pour les basses viscosités."
          : ""
      );
    }
  };

  type Champ = HTMLInputElement | HTMLSelectElement;
  const tousLesChamps = () =>
    Array.from(
      document.querySelectorAll<Champ>(
        ".calc-carte input:not([type=hidden]), .calc-carte select"
      )
    );

  // Valeurs d'origine de la page, capturées AVANT toute restauration : c'est
  // vers elles que ramène le bouton « Réinitialiser ».
  const valeursParDefaut = new Map(tousLesChamps().map((c) => [c.id, c.value]));

  /**
   * Applique un lot de valeurs, en reconstruisant d'abord les listes d'huiles :
   * les filtres conditionnent les options disponibles, donc l'ordre compte.
   *
   * `propagation` sert aux exemples : remplir un champ par programme ne
   * déclenche aucun évènement, il faut donc reporter explicitement les valeurs
   * vers les champs jumeaux. Inutile pour une restauration ou une remise à
   * zéro, où le lot est déjà complet et cohérent.
   */
  const appliquerValeurs = (
    valeurs: Record<string, string>,
    { propagation = false } = {}
  ) => {
    Object.entries(valeurs).forEach(([id, valeur]) => {
      if (!id.includes("-filtre-")) return;
      const champ = document.getElementById(id) as Champ | null;
      if (champ) champ.value = valeur;
    });
    ["vi", "gi"].forEach((p) => construireOptionsHuiles(p));
    const appliques: Champ[] = [];
    Object.entries(valeurs).forEach(([id, valeur]) => {
      if (id.includes("-filtre-")) return;
      const champ = document.getElementById(id) as Champ | null;
      if (!champ) return;
      // Une huile mémorisée peut ne plus figurer dans la liste filtrée.
      if (
        champ instanceof HTMLSelectElement &&
        !Array.from(champ.options).some((o) => o.value === valeur)
      ) return;
      champ.value = valeur;
      appliques.push(champ);
    });
    if (propagation) appliques.forEach((champ) => propager(champ));
    // Les conversions sont des valeurs derivees : toujours les recalculer.
    appliques.forEach((champ) => {
      if (champ.classList.contains("calc-conv")) convertirDepuis(champ as HTMLInputElement);
    });
    ["vi", "gi"].forEach((p) => majHuile(p));
    majModeBilan();
    majInconnueAccu();
    calculer();
  };

  // ------------------------------------------------------------------
  // Mémorisation des saisies dans ce navigateur
  // ------------------------------------------------------------------
  const CLE_STOCKAGE = "hydrodidac-calculateurs";
  let lierValeurs = true;

  const enregistrer = () => {
    try {
      const donnees: Record<string, string> = {};
      tousLesChamps().forEach((c) => { if (c.id) donnees[c.id] = c.value; });
      donnees.__lier = lierValeurs ? "1" : "0";
      localStorage.setItem(CLE_STOCKAGE, JSON.stringify(donnees));
    } catch {
      // Navigation privée ou stockage plein : on continue sans mémoriser.
    }
  };

  const restaurer = () => {
    let donnees: Record<string, string> | null = null;
    try {
      donnees = JSON.parse(localStorage.getItem(CLE_STOCKAGE) ?? "null");
    } catch {
      donnees = null;
    }
    if (!donnees) return;
    lierValeurs = donnees.__lier !== "0";
    const caseLier = document.getElementById("calc-lier") as HTMLInputElement | null;
    if (caseLier) caseLier.checked = lierValeurs;
    const champsMemorises = { ...donnees };
    delete champsMemorises.__lier;
    appliquerValeurs(champsMemorises);
  };

  const reinitialiser = () => {
    try { localStorage.removeItem(CLE_STOCKAGE); } catch { /* sans effet */ }
    appliquerValeurs(Object.fromEntries(valeursParDefaut));
    document.querySelectorAll(".calc-exemple-note").forEach((n) => { n.textContent = ""; });
  };

  // ------------------------------------------------------------------
  // Liaison des valeurs communes entre calculateurs
  // ------------------------------------------------------------------
  const grandeurDuChamp = new Map<string, string>();
  Object.entries(grandeursLiees).forEach(([grandeur, ids]) =>
    (ids as string[]).forEach((id) => grandeurDuChamp.set(id, grandeur))
  );

  /**
   * Reporte la valeur saisie dans tous les champs qui désignent la même
   * grandeur physique : on étudie en général un seul circuit à la fois.
   */
  const propager = (source: Champ) => {
    if (!lierValeurs) return;
    const grandeur = grandeurDuChamp.get(source.id);
    if (!grandeur) return;
    const jumeaux = grandeursLiees[grandeur as keyof typeof grandeursLiees] as string[];
    jumeaux.forEach((id) => {
      if (id === source.id) return;
      const champ = document.getElementById(id) as HTMLInputElement | null;
      if (champ && champ.value !== source.value) champ.value = source.value;
    });
  };

  // ------------------------------------------------------------------
  // Branchement des champs
  // ------------------------------------------------------------------
  // Chaque filtre et chaque liste d'huiles porte un data-prefixe qui indique le
  // calculateur auquel il appartient (« vi » viscosité, « gi » gicleur).
  document.querySelectorAll(".calc-filtre").forEach((champ) => {
    champ.addEventListener("change", () => {
      const p = (champ as HTMLElement).dataset.prefixe ?? "vi";
      construireOptionsHuiles(p);
      majHuile(p);
      calculer();
      enregistrer();
    });
  });

  document.querySelectorAll(".calc-huile-select").forEach((champ) => {
    champ.addEventListener("change", () => {
      majHuile((champ as HTMLElement).dataset.prefixe ?? "vi");
      calculer();
      enregistrer();
    });
  });

  document
    .querySelectorAll<Champ>(".calc-carte input, .calc-carte select:not(.calc-filtre):not(.calc-huile-select)")
    .forEach((champ) => {
      const reagir = () => {
        propager(champ);
        if (champ.classList.contains("calc-conv")) convertirDepuis(champ as HTMLInputElement);
        calculer();
        enregistrer();
      };
      champ.addEventListener("input", reagir);
      champ.addEventListener("change", reagir);
    });

  document.getElementById("bt-mode")?.addEventListener("change", majModeBilan);
  document.getElementById("ac-inconnue")?.addEventListener("change", () => { majInconnueAccu(); calculer(); });

  // ------------------------------------------------------------------
  // Exemples pré-remplis : partir d'un cas réel plutôt que d'un formulaire vide
  // ------------------------------------------------------------------
  document.querySelectorAll<HTMLButtonElement>("[data-exemple]").forEach((bouton) => {
    bouton.addEventListener("click", () => {
      const id = bouton.dataset.exemple ?? "";
      const exemple = exemples[id as keyof typeof exemples];
      if (!exemple) return;
      appliquerValeurs(
        Object.fromEntries(
          Object.entries(exemple.valeurs).map(([champ, valeur]) => [champ, String(valeur)])
        ),
        { propagation: true }
      );
      enregistrer();
      const note = document.getElementById(`${id}-exemple-note`);
      if (note) note.textContent = exemple.commentaire;
    });
  });

  // ------------------------------------------------------------------
  // Barre d'outils
  // ------------------------------------------------------------------
  document.getElementById("calc-lier")?.addEventListener("change", (evenement) => {
    lierValeurs = (evenement.target as HTMLInputElement).checked;
    enregistrer();
  });
  document.getElementById("calc-reinit")?.addEventListener("click", reinitialiser);
  document.getElementById("calc-imprimer")?.addEventListener("click", () => window.print());

  // En-tête de la note de calcul imprimée : rappelle ce qui est imprimé et quand.
  window.addEventListener("beforeprint", () => {
    const entete = document.getElementById("calc-print-entete");
    if (!entete) return;
    const visibles = Array.from(document.querySelectorAll<HTMLElement>(".calc-carte"))
      .filter((carte) => !carte.hidden)
      .map((carte) => carte.querySelector("h2")?.textContent ?? "")
      .filter(Boolean);
    const date = new Date().toLocaleDateString("fr-FR", {
      day: "numeric", month: "long", year: "numeric",
    });
    entete.textContent =
      `Note de calcul HydroDidac — ${date} — ` +
      `${visibles.length > 2 ? "tous les calculateurs" : visibles.join(", ")}. ` +
      `Valeurs théoriques, à confronter aux données constructeur.`;
  });

  majHuile("vi");
  majHuile("gi");
  majModeBilan();
  majInconnueAccu();
  // Amorce les conversions a partir des valeurs par defaut du cote gauche.
  document.querySelectorAll<HTMLInputElement>(".calc-conv").forEach((champ) => {
    if (champ.value) convertirDepuis(champ);
  });
  calculer();
  restaurer();

  // Sommaire cliquable : au lieu d'un simple ancrage, chaque lien filtre
  // l'affichage pour ne montrer QUE le calculateur choisi (plus lisible sur un
  // sujet précis). « Tous les calculateurs » revient à la grille complète.
  // L'état choisi vit dans l'URL (#calc-xxx) pour rester partageable et
  // fonctionner avec le bouton retour du navigateur.
  const TOUS = "tous";
  const grille = document.querySelector(".calc-grille");
  const boutonRetour = document.getElementById("calc-retour");
  const cartes = Array.from(document.querySelectorAll(".calc-carte[id]"));
  let modeTous = true;

  const appliquerFiltre = (cible: string) => {
    const carteCible = cible !== TOUS ? document.getElementById(cible) : null;
    modeTous = !carteCible;
    cartes.forEach((carte) => {
      carte.hidden = !modeTous && carte !== carteCible;
    });
    grille?.classList.toggle("calc-grille--unique", !modeTous);
    boutonRetour?.toggleAttribute("hidden", modeTous);
    document.querySelectorAll(".calc-sommaire a[data-cible]").forEach((lien) => {
      const cibleLien = (lien as HTMLElement).dataset.cible;
      lien.classList.toggle("actif", modeTous ? cibleLien === TOUS : cibleLien === cible);
    });
  };

  document.querySelectorAll("a[data-cible]").forEach((lien) => {
    lien.addEventListener("click", (evenement) => {
      evenement.preventDefault();
      const cible = (lien as HTMLElement).dataset.cible ?? TOUS;
      history.pushState(null, "", cible === TOUS ? location.pathname + location.search : `#${cible}`);
      appliquerFiltre(cible);
      document.querySelector(".calc-contenu")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });
  window.addEventListener("popstate", () => appliquerFiltre(location.hash.slice(1) || TOUS));
  // Arrivée depuis la recherche globale ou une autre page : l'ancre change sans
  // recharger la page, il faut donc réappliquer le filtre.
  window.addEventListener("hashchange", () => appliquerFiltre(location.hash.slice(1) || TOUS));
  appliquerFiltre(location.hash.slice(1) || TOUS);

  // En mode « Tous les calculateurs » : met en surbrillance dans le sommaire
  // celui actuellement visible à l'écran pendant le défilement.
  const observateur = new IntersectionObserver(
    (entrees) => {
      if (!modeTous) return;
      entrees.forEach((entree) => {
        const lien = document.querySelector(`.calc-sommaire a[data-cible="${entree.target.id}"]`);
        lien?.classList.toggle("actif", entree.isIntersecting);
      });
    },
    { rootMargin: "-25% 0px -65% 0px" }
  );
  cartes.forEach((carte) => observateur.observe(carte));
</script>
