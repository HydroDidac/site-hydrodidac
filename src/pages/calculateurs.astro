    vertical-align: middle;
  }
  .calc-huile-info h3 {
    margin: 0 0 0.3rem;
    font-family: var(--font-texte);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-anthracite);
    border-bottom: none;
    padding-bottom: 0;
  }
  .calc-huile-info p {
    margin: 0 0 0.9rem;
    font-size: var(--taille-petit);
