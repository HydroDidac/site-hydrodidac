---
// Pied de carte d'un calculateur : bouton « exemple », fiches à lire et liens
// vers les calculateurs voisins. Tout est piloté par src/data/calculateurs-nav.js
// à partir du seul identifiant de la carte — une carte = une ligne à insérer.
//
// Les liens portent data-cible, ce qui les branche automatiquement sur le
// filtrage de la page (cliquer n'affiche que le calculateur visé).
import {
  liens,
  fichesLiees,
  exemples,
  libelleCalculateur,
} from "../data/calculateurs-nav.js";
import { getGroupesFiches } from "../lib/fiches";

const { id } = Astro.props;

// On ignore silencieusement un lien vers un calculateur qui n'existe pas
// encore : la liste peut anticiper des calculateurs à venir.
const cibles = (liens[id] ?? []).filter((cible) => libelleCalculateur(cible));

// Idem pour les fiches : seules celles réellement publiées sont affichées, pour
// ne jamais produire de lien mort pendant que le Pôle B rattrape ses imports.
const groupes = await getGroupesFiches();
const fiches = (fichesLiees[id] ?? [])
  .map((code) => groupes.find((g) => g.code === code))
  .filter(Boolean);

const exemple = exemples[id];
---

<div class="calc-pied">
  {exemple && (
    <p class="calc-exemple">
      <button type="button" class="calc-exemple-btn" data-exemple={id}>
        📋 Voir un exemple : {exemple.titre}
      </button>
      <span class="calc-exemple-note" id={`${id}-exemple-note`}></span>
    </p>
  )}

  {fiches.length > 0 && (
    <p class="calc-fiches">
      <span class="calc-pied-titre">Pour comprendre</span>
      {fiches.map((fiche) => (
        <a href={`/fiches/${fiche.slug}`} class="calc-fiche-lien">
          {fiche.code} · {fiche.titre}
        </a>
      ))}
    </p>
  )}

  {cibles.length > 0 && (
    <p class="calc-liens">
      <span class="calc-pied-titre">Voir aussi</span>
      {cibles.map((cible) => (
        <a href={`#${cible}`} data-cible={cible}>{libelleCalculateur(cible)}</a>
      ))}
    </p>
  )}
</div>

<style>
  .calc-pied {
    margin-top: 0.9rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-gris-bordure);
  }
  .calc-pied p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin: 0 0 0.6rem;
  }
  .calc-pied p:last-child {
    margin-bottom: 0;
  }
  .calc-pied-titre {
    font-family: var(--font-texte);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #51606b;
  }

  /* Exemple pré-rempli */
  .calc-exemple-btn {
    font-family: var(--font-texte);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-anthracite);
    background: var(--color-formule-fond);
    border: 1px solid var(--color-formule-bordure);
    border-radius: 4px;
    padding: 0.35em 0.7em;
    cursor: pointer;
    text-align: left;
  }
  .calc-exemple-btn:hover {
    background: var(--color-ambre);
    border-color: var(--color-ambre);
    color: var(--color-anthracite);
  }
  .calc-exemple-note {
    font-size: 0.78rem;
    color: #51606b;
    flex: 1 1 100%;
  }
  .calc-exemple-note:empty {
    display: none;
  }

  /* Fiches et calculateurs voisins */
  .calc-fiche-lien,
  .calc-liens a {
    font-family: var(--font-texte);
    font-size: 0.78rem;
    text-decoration: none;
    border-radius: 999px;
    padding: 0.2em 0.7em;
    border: 1px solid var(--color-gris-bordure);
  }
  .calc-liens a {
    color: var(--color-bleu-hydraulique);
    background: var(--color-gris-clair);
  }
  .calc-liens a:hover {
    color: var(--color-blanc);
    background: var(--color-bleu-hydraulique);
    border-color: var(--color-bleu-hydraulique);
  }
  .calc-fiche-lien {
    color: var(--color-anthracite);
    background: var(--color-blanc);
    border-style: dashed;
  }
  .calc-fiche-lien:hover {
    color: var(--color-blanc);
    background: var(--color-anthracite);
    border-color: var(--color-anthracite);
  }

  @media print {
    .calc-pied {
      display: none;
    }
  }
</style>
