---
import "../styles/fonts.css";
import "../styles/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** Chemin (absolu ou relatif au site) d'une image 1200×630 pour les partages réseaux. */
  ogImage?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = "Fiches didactiques sur l'hydraulique industrielle, par un expert métier.",
  ogImage,
  structuredData,
} = Astro.props;

const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="HydroDidac" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <a href="#contenu" class="lien-evitement">Aller au contenu</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
