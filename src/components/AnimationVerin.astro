---
// Animation pédagogique d'un vérin double effet en coupe : la tige avance et
// recule en boucle, chambres colorées selon le côté sous pression, cotes D
// (alésage), d (tige) et Course en bas. Schéma de principe à but pédagogique,
// inspiré des coupes techniques classiques — pas un plan ISO normé.
---
<figure class="animation-verin no-print">
  <svg viewBox="0 0 480 230" role="img" aria-label="Coupe animée d'un vérin double effet en mouvement">
    <defs>
      <pattern id="hachure" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="6" height="6" fill="var(--color-gris-clair)" />
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--color-anthracite)" stroke-width="1" opacity="0.55" />
      </pattern>
      <marker id="fleche-cote" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
        <path d="M0,1 L7,4 L0,7" fill="none" stroke="var(--color-anthracite)" stroke-width="1.2" />
      </marker>
    </defs>

    <!-- Culasse fond (cote fixe, gauche) -->
    <rect x="50" y="55" width="22" height="110" fill="url(#hachure)" stroke="var(--color-anthracite)" stroke-width="1.5" />

    <!-- Tube du verin : parois hachurees -->
    <rect x="72" y="70" width="220" height="8" fill="url(#hachure)" />
    <rect x="72" y="142" width="220" height="8" fill="url(#hachure)" />
    <rect x="72" y="70" width="220" height="80" fill="none" stroke="var(--color-anthracite)" stroke-width="1.5" />

    <!-- Chambres (fond / tige) avec mise en evidence du cote sous pression -->
    <rect class="anim-chambre anim-chambre-fond" x="73" y="78" width="217" height="64" fill="var(--color-bleu-hydraulique)" />
    <rect class="anim-chambre anim-chambre-tige" x="73" y="78" width="217" height="64" fill="var(--color-ambre)" />

    <!-- Culasse tete / presse-etoupe (cote droit, fixe, passage pour la tige) -->
    <rect x="292" y="55" width="20" height="45" fill="url(#hachure)" stroke="var(--color-anthracite)" stroke-width="1.5" />
    <rect x="292" y="120" width="20" height="45" fill="url(#hachure)" stroke="var(--color-anthracite)" stroke-width="1.5" />

    <!-- Orifice P (fond) -->
    <g class="anim-port anim-port-fond">
      <rect x="100" y="50" width="10" height="20" fill="var(--color-gris-bordure)" stroke="var(--color-anthracite)" stroke-width="1" />
      <path d="M105,32 L99,46 L111,46 Z" fill="var(--color-bleu-hydraulique)" />
      <text x="105" y="24" text-anchor="middle" class="anim-label">P</text>
    </g>

    <!-- Orifice T (tige) -->
    <g class="anim-port anim-port-tige">
      <rect x="255" y="50" width="10" height="20" fill="var(--color-gris-bordure)" stroke="var(--color-anthracite)" stroke-width="1" />
      <path d="M260,32 L254,46 L266,46 Z" fill="var(--color-ambre)" />
      <text x="260" y="24" text-anchor="middle" class="anim-label">T</text>
    </g>

    <!-- Groupe mobile : piston + tige + oeil d'attache (position de depart = retracte) -->
    <g class="anim-mobile">
      <rect x="95" y="76" width="18" height="68" fill="var(--color-anthracite)" />
      <rect x="97" y="80" width="14" height="3" fill="var(--color-gris-clair)" opacity="0.7" />
      <rect x="97" y="140" width="14" height="3" fill="var(--color-gris-clair)" opacity="0.7" />
      <rect x="113" y="100" width="215" height="20" fill="var(--color-gris-bordure)" stroke="var(--color-anthracite)" stroke-width="1.2" />
      <circle cx="328" cy="110" r="12" fill="var(--color-gris-bordure)" stroke="var(--color-anthracite)" stroke-width="1.5" />
      <circle cx="328" cy="110" r="4" fill="var(--color-blanc)" stroke="var(--color-anthracite)" stroke-width="1" />
    </g>

    <!-- Cote D (alesage) -->
    <line x1="32" y1="78" x2="32" y2="142" stroke="var(--color-anthracite)" stroke-width="1" marker-start="url(#fleche-cote)" marker-end="url(#fleche-cote)" />
    <line x1="28" y1="78" x2="50" y2="78" stroke="var(--color-anthracite)" stroke-width="0.75" />
    <line x1="28" y1="142" x2="50" y2="142" stroke="var(--color-anthracite)" stroke-width="0.75" />
    <text x="18" y="113" text-anchor="middle" class="anim-label" transform="rotate(-90 18 113)">D</text>

    <!-- Cote d (tige) -->
    <line x1="332" y1="100" x2="332" y2="120" stroke="var(--color-anthracite)" stroke-width="1" marker-start="url(#fleche-cote)" marker-end="url(#fleche-cote)" />
    <line x1="312" y1="100" x2="336" y2="100" stroke="var(--color-anthracite)" stroke-width="0.75" />
    <line x1="312" y1="120" x2="336" y2="120" stroke="var(--color-anthracite)" stroke-width="0.75" />
    <text x="345" y="114" class="anim-label">d</text>

    <!-- Cote Course -->
    <line x1="72" y1="195" x2="72" y2="207" stroke="var(--color-anthracite)" stroke-width="0.75" />
    <line x1="292" y1="195" x2="292" y2="207" stroke="var(--color-anthracite)" stroke-width="0.75" />
    <line x1="72" y1="200" x2="292" y2="200" stroke="var(--color-ambre)" stroke-width="1.5" marker-start="url(#fleche-cote)" marker-end="url(#fleche-cote)" />
    <text x="182" y="216" text-anchor="middle" class="anim-label">Course</text>

    <!-- Labels chambres -->
    <text x="110" y="135" text-anchor="middle" class="anim-label anim-label-petit">S₁ (fond)</text>
    <text x="245" y="135" text-anchor="middle" class="anim-label anim-label-petit">S₂ (tige)</text>
  </svg>
  <figcaption>Vérin double effet en mouvement — D = diamètre d'alésage, d = diamètre de tige, S₁/S₂ = surfaces fond/tige.</figcaption>
</figure>
