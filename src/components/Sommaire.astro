---
import { getGroupesFiches } from "../lib/fiches";
import { MODULES } from "../lib/modules";

const groupes = await getGroupesFiches();
const compteParModule = new Map<string, number>();
for (const groupe of groupes) {
  compteParModule.set(groupe.module, (compteParModule.get(groupe.module) ?? 0) + 1);
}
---
<nav class="sommaire no-print" aria-label="Sommaire des fiches techniques">
  <ol class="sommaire-liste">
    {MODULES.map((module) => {
      const nb = compteParModule.get(module.nom) ?? 0;
      return (
        <li>
          <a href={`/fiches#module-${module.slug}`} class={nb === 0 ? "sommaire-vide" : ""}>
            <span class="sommaire-numero">{module.numero}</span>
            <span>{module.nom}</span>
            <span class="sommaire-compte">{nb}</span>
          </a>
        </li>
      );
    })}
  </ol>
</nav>
